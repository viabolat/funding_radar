# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Dashboard
web/node_modules/
web/dist/
web/*.tsbuildinfo

# reason: a global ~/.gitignore_global excluding *.csv silently dropped this
# fixture, and the test suite cannot run without it — it is a real captured
# payload, BOM included. A repo .gitignore overrides the global one.
!tests/fixtures/*.csv

# Local scratch — note that seen_calls.json, mipe_page_hashes.json and
# calls.json are NOT ignored: they are the state the scheduled workflows
# commit back, and the radar depends on them persisting between runs.
.DS_Store

# Provenance receipts and the EU dataset cache. Never committed: the samples can
# be large, the full-body mode is ~130 MB, and the repo is the state store for
# the watchers — evidence belongs in an Actions artifact, not in history.
evidence/
.cache/

# Mockup outputs, and the base bundle they are built from. The bundle is 6.9 MB
# of embedded fonts and React that build_variants.py lifts verbatim — a sales
# asset, not product source, and not worth carrying in every clone forever. It
# has to be present at the repo root to build; see mockup/README.md.
mockup/dist/
/ViaBolat - machetă.html
